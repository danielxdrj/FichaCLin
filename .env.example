# Copie para .env. Valores abaixo são APENAS para desenvolvimento local.
NODE_ENV=development
API_PORT=3333

# Papel dono: usado só para migrações (ADR-001)
DATABASE_OWNER_URL=postgres://fichaclin_owner:dev_owner_password@localhost:5434/fichaclin
# Papel da aplicação: sem BYPASSRLS, sujeito às políticas de RLS (REQ-26)
DATABASE_URL=postgres://fichaclin_app:dev_app_password@localhost:5434/fichaclin
APP_DB_PASSWORD=dev_app_password

# Canal do encarregado (REQ-10) — substituir pelo encarregado nomeado
DPO_NAME=Encarregado (a definir)
DPO_EMAIL=encarregado@fichaclin.example
