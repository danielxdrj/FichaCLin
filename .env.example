# Copie para .env. Valores abaixo são APENAS para desenvolvimento local.
# Em produção, defina valores fortes nas variáveis da stack do Portainer (docs/deploy/PRODUCAO.md).

# --- Banco (usado pelo docker compose) ---
DB_OWNER_PASSWORD=dev_owner_password
APP_DB_PASSWORD=dev_app_password

# --- API rodando fora do Docker (npm run dev) ---
NODE_ENV=development
API_PORT=3333
# Papel dono: usado só para migrações (ADR-001)
DATABASE_OWNER_URL=postgres://fichaclin_owner:dev_owner_password@localhost:5434/fichaclin
# Papel da aplicação: sem BYPASSRLS, sujeito às políticas de RLS (REQ-26)
DATABASE_URL=postgres://fichaclin_app:dev_app_password@localhost:5434/fichaclin

# --- Canal do encarregado (REQ-10) — substituir pelo encarregado nomeado ---
DPO_NAME=Encarregado (a definir)
DPO_EMAIL=encarregado@fichaclin.example

# --- Produção (deixe em branco localmente) ---
# SITE_ADDRESS=app.seudominio.com.br
# BACKUP_AGE_RECIPIENT=age1...            chave PÚBLICA do backup
# BACKUP_RCLONE_REMOTE=backup:fichaclin-backups
# BACKUP_RCLONE_TYPE=s3
# BACKUP_RCLONE_PROVIDER=Other
# BACKUP_RCLONE_ENDPOINT=https://...
# BACKUP_RCLONE_ACCESS_KEY_ID=
# BACKUP_RCLONE_SECRET_ACCESS_KEY=
